# Optional: CoinGecko Demo / Pro API key. Free tier works without one.
ALPHASCANNER_COINGECKO_API_KEY=

# CoinGecko API base URL. Leave as-is for the free/Demo tier. For a Pro key,
# set this to https://pro-api.coingecko.com/api/v3 (required so the client
# sends x-cg-pro-api-key instead of x-cg-demo-api-key).
ALPHASCANNER_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# SQLite database location.
ALPHASCANNER_DB_PATH=/data/alphascanner.db

# Number of pages of 250 to pull (4 = top 1000 coins by market cap).
ALPHASCANNER_FETCH_PAGES=4

# Snapshot interval in minutes.
ALPHASCANNER_FETCH_INTERVAL_MINUTES=15

# Quote currency.
ALPHASCANNER_VS_CURRENCY=usd

# How many recent snapshots to average for "volume surge" baseline.
ALPHASCANNER_HISTORY_WINDOW=20

# Optional: require HTTP Basic Auth on the web UI/API (not /healthz).
# Leave ALPHASCANNER_AUTH_PASSWORD blank to disable auth (fine for
# localhost-only use). Set a password if this is reachable beyond localhost.
ALPHASCANNER_AUTH_USERNAME=admin
ALPHASCANNER_AUTH_PASSWORD=

# Max requests per client IP per minute to the web UI/API (not /healthz).
ALPHASCANNER_RATE_LIMIT_PER_MINUTE=60
